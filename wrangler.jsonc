{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktok-downloader",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only on the custom domain (tokdown.org); the workers.dev copy duplicated the site and the API
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: lets the dashboard show which requests hit the CPU limit (Error 1102)
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
